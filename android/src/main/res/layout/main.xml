<!-- The only screen: toolbar, messages, the map (or, with no map open, the buttons to
     open or create one and the recent maps), what the marks of the selected node mean,
     and its commands. -->
<!-- The ☰ drawer (navigation) slides over the screen's content. -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/forest"
        android:minHeight="?android:attr/actionBarSize"
        android:theme="@style/Mapling.Toolbar" />

    <!-- Banners: read-only map, hidden content, drafts not protected. -->
    <LinearLayout
        android:id="@+id/messages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />

        <!-- With no map open: open one, create one, or pick a recent one. -->
        <ScrollView
            android:id="@+id/home"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/open_map"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/open_map" />

                    <Button
                        android:id="@+id/new_map"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/new_map" />
                </LinearLayout>

                <TextView
                    android:id="@+id/recent_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:paddingBottom="8dp"
                    android:text="@string/recent_maps"
                    android:textColor="@color/forest"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/recent_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- What the lock and the dot of the selected node mean. -->
    <LinearLayout
        android:id="@+id/hints"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/node_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/node_bar"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/edit_text"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:contentDescription="@string/edit_text"
            android:src="@drawable/ic_edit"
            app:tint="@color/node_icon"
            android:tooltipText="@string/edit_text" />

        <ImageButton
            android:id="@+id/add_child"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:contentDescription="@string/add_child"
            android:src="@drawable/ic_subdirectory_arrow_right"
            app:tint="@color/node_icon"
            android:tooltipText="@string/add_child" />

        <ImageButton
            android:id="@+id/add_sibling"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:contentDescription="@string/add_sibling"
            android:src="@drawable/ic_add_row_below"
            app:tint="@color/node_icon"
            android:tooltipText="@string/add_sibling" />

        <ImageButton
            android:id="@+id/delete_node"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:contentDescription="@string/delete_node"
            android:src="@drawable/ic_delete"
            app:tint="@color/node_icon"
            android:tooltipText="@string/delete_node" />
    </LinearLayout>
</LinearLayout>

    <!-- The ☰ drawer: the open map (header), the commands, the recent maps, About. -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:itemIconTint="@color/menu_icon"
        app:itemMaxLines="2" />
</androidx.drawerlayout.widget.DrawerLayout>

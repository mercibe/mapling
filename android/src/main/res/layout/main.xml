<!-- The main screen: toolbar, messages, the map (or, with no map open, the buttons to
     open or create one and the recent maps), what the marks of the selected node mean,
     and its commands. -->
<!-- The ☰ drawer (navigation) slides over the screen's content. -->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

<LinearLayout
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/forest"
        android:minHeight="?android:attr/actionBarSize"
        android:theme="@style/Mapling.Toolbar" />

    <!-- Banners: read-only map, hidden content, drafts not protected. -->
    <LinearLayout
        android:id="@+id/messages"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <WebView
            android:id="@+id/map"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible" />

        <!-- With no map open: open one, create one, or pick a recent one. -->
        <ScrollView
            android:id="@+id/home"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/open_map"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/open_map" />

                    <Button
                        android:id="@+id/new_map"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/new_map" />
                </LinearLayout>

                <TextView
                    android:id="@+id/recent_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:paddingBottom="8dp"
                    android:text="@string/recent_maps"
                    android:textColor="@color/forest"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/recent_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
    </FrameLayout>

    <!-- What the lock and the dot of the selected node mean. -->
    <LinearLayout
        android:id="@+id/hints"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- While a Markdown note is edited, above the bottom bar: its formats. Never focused,
         so that the note's text keeps the focus and the keyboard. -->
    <LinearLayout
        android:id="@+id/format_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/node_bar"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/format_bold"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="@dimen/node_button_width"
            android:layout_height="48dp"
            android:contentDescription="@string/format_bold"
            android:focusable="false"
            android:src="@drawable/ic_format_bold"
            app:tint="@color/node_icon"
            android:tooltipText="@string/format_bold" />
        <ImageButton
            android:id="@+id/format_italic"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="@dimen/node_button_width"
            android:layout_height="48dp"
            android:contentDescription="@string/format_italic"
            android:focusable="false"
            android:src="@drawable/ic_format_italic"
            app:tint="@color/node_icon"
            android:tooltipText="@string/format_italic" />
        <ImageButton
            android:id="@+id/format_heading"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="@dimen/node_button_width"
            android:layout_height="48dp"
            android:contentDescription="@string/format_heading"
            android:focusable="false"
            android:src="@drawable/ic_title"
            app:tint="@color/node_icon"
            android:tooltipText="@string/format_heading" />
        <ImageButton
            android:id="@+id/format_bullet_list"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="@dimen/node_button_width"
            android:layout_height="48dp"
            android:contentDescription="@string/format_bullet_list"
            android:focusable="false"
            android:src="@drawable/ic_format_list_bulleted"
            app:tint="@color/node_icon"
            android:tooltipText="@string/format_bullet_list" />
        <ImageButton
            android:id="@+id/format_numbered_list"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="@dimen/node_button_width"
            android:layout_height="48dp"
            android:contentDescription="@string/format_numbered_list"
            android:focusable="false"
            android:src="@drawable/ic_format_list_numbered"
            app:tint="@color/node_icon"
            android:tooltipText="@string/format_numbered_list" />
    </LinearLayout>

    <!-- With a map open: its ends stay: Delete (the node, or the note shown) at the start,
         and ⋮ at the end; in between, the selected node's commands, or the note's: ‹, pencil
         or eye, ›. -->
    <FrameLayout
        android:id="@+id/node_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/node_bar"
        android:visibility="gone">

        <!-- Apart, at the start: away from the frequent commands and from ⋮, so that a
             tap meant for another button deletes nothing. -->
        <ImageButton
            android:id="@+id/delete_node"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="@dimen/node_button_width"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/delete_node"
            android:src="@drawable/ic_delete"
            app:tint="@color/node_icon"
            android:tooltipText="@string/delete_node" />

        <ImageButton
            android:id="@+id/delete_note"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="@dimen/node_button_width"
            android:layout_height="48dp"
            android:layout_gravity="start|center_vertical"
            android:contentDescription="@string/delete_note"
            android:src="@drawable/ic_delete"
            android:visibility="gone"
            app:tint="@color/node_icon"
            android:tooltipText="@string/delete_note" />

        <!-- Centered, with room kept at the start for Delete and at the end for ⋮, so that
             it never overlaps them. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/node_button_width"
            android:layout_marginEnd="@dimen/node_button_width"
            android:orientation="horizontal">

            <!-- Its description says add or edit, by the node (render). -->
            <ImageButton
                android:id="@+id/edit_link"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="@dimen/node_button_width"
                android:layout_height="48dp"
                android:contentDescription="@string/add_link"
                android:src="@drawable/ic_link"
                app:tint="@color/node_icon"
                android:tooltipText="@string/add_link" />

            <ImageButton
                android:id="@+id/open_note"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="@dimen/node_button_width"
                android:layout_height="48dp"
                android:contentDescription="@string/open_note"
                android:src="@drawable/ic_description"
                app:tint="@color/node_icon"
                android:tooltipText="@string/open_note" />

            <ImageButton
                android:id="@+id/add_child"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="@dimen/node_button_width"
                android:layout_height="48dp"
                android:contentDescription="@string/add_child"
                android:src="@drawable/ic_subdirectory_arrow_right"
                app:tint="@color/node_icon"
                android:tooltipText="@string/add_child" />

            <ImageButton
                android:id="@+id/add_sibling"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="@dimen/node_button_width"
                android:layout_height="48dp"
                android:contentDescription="@string/add_sibling"
                android:src="@drawable/ic_add_row_below"
                app:tint="@color/node_icon"
                android:tooltipText="@string/add_sibling" />

            <ImageButton
                android:id="@+id/previous_note"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="@dimen/node_button_width"
                android:layout_height="48dp"
                android:contentDescription="@string/previous_node"
                android:src="@drawable/ic_chevron_left"
                android:visibility="gone"
                app:tint="@color/node_icon"
                android:tooltipText="@string/previous_node" />

            <!-- A pencil to edit the note read, an eye to read the note edited (render). -->
            <ImageButton
                android:id="@+id/edit_note"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="@dimen/node_button_width"
                android:layout_height="48dp"
                android:contentDescription="@string/edit_note"
                android:src="@drawable/ic_edit"
                android:visibility="gone"
                app:tint="@color/node_icon"
                android:tooltipText="@string/edit_note" />

            <ImageButton
                android:id="@+id/next_note"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="@dimen/node_button_width"
                android:layout_height="48dp"
                android:contentDescription="@string/next_node"
                android:src="@drawable/ic_chevron_right"
                android:visibility="gone"
                app:tint="@color/node_icon"
                android:tooltipText="@string/next_node" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/more"
            style="?android:attr/borderlessButtonStyle"
            android:layout_width="@dimen/node_button_width"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:contentDescription="@string/more"
            android:src="@drawable/ic_more_vert"
            app:tint="@color/node_icon"
            android:tooltipText="@string/more" />
    </FrameLayout>
</LinearLayout>

    <!-- The ☰ drawer: the open map (header), the commands, the recent maps, About. -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigation"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:itemIconTint="@color/menu_icon"
        app:itemMaxLines="2" />
</androidx.drawerlayout.widget.DrawerLayout>

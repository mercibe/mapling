<!-- No INTERNET permission, on purpose: the app never uses the network, so the
     system denies it any connection (see AssetServer). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- No backup: drafts hold whole maps; nothing goes to the user's cloud backup
         without their choice (PRIVACY.md). allowBackup up to Android 11,
         dataExtractionRules from Android 12 (Lint asks for fullBackupContent too, which
         allowBackup="false" makes useless). -->
    <application
        tools:ignore="DataExtractionRules"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="tiramisu"
        android:icon="@mipmap/mapling_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Mapling">

        <!-- configChanges: rotating the phone or opening a keyboard must not recreate
             the activity, which would reload the WebView and lose the open map.
             singleTask: one instance only, whatever starts it. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Open with Mapling" from another app (Files, Drive, an attachment…): maps only. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/x-freemind" />
            </intent-filter>
        </activity>
    </application>
</manifest>

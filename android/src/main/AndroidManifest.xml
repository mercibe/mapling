<!-- No INTERNET permission, on purpose: the app never uses the network, so the
     system denies it any connection (see AssetServer). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:icon="@mipmap/mapling_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Mapling">

        <!-- configChanges: rotating the phone or opening a keyboard must not recreate
             the activity, which would reload the WebView and lose the open map.
             singleTask: one instance only, whatever starts it. -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden"
            android:launchMode="singleTask"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
